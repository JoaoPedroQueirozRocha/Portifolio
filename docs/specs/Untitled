## Estrutura do componente

```tsx
'use client'

import { useEffect, useRef, useState } from 'react'

export function AstrolabeLoader({
  size = 380,
  label = 'Carregando',
  showProgress = true,
  duration = 3500,
  onComplete,
}: AstrolabeLoaderProps) {
  const canvasRef = useRef<HTMLCanvasElement>(null)
  const rafRef    = useRef<number>()
  const [progress, setProgress] = useState(0)
  const [dots, setDots]         = useState('')

  useEffect(() => {
    // lógica de animação via requestAnimationFrame
    // ver seção "Lógica de animação" abaixo
    return () => { if (rafRef.current) cancelAnimationFrame(rafRef.current) }
  }, [size])

  useEffect(() => {
    if (progress >= 100) onComplete?.()
  }, [progress, onComplete])

  return (
    <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
      <canvas ref={canvasRef} width={size} height={size} />
      <p className="astrolabe-label">{label}{dots}</p>
      {showProgress && (
        <div className="astrolabe-bar-track">
          <div className="astrolabe-bar-fill" style={{ width: `${progress}%` }} />
        </div>
      )}
    </div>
  )
}
```

