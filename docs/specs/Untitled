## Uso — Splash screen (primeira visita)

```tsx
// app/layout.tsx  ou  components/SplashGate.tsx
'use client'

import { useEffect, useState } from 'react'
import { AstrolabeLoader } from '@/components/ui/AstrolabeLoader'

export function SplashGate({ children }: { children: React.ReactNode }) {
  const [ready, setReady] = useState(false)

  useEffect(() => {
    const seen = sessionStorage.getItem('splash-seen')
    if (seen) setReady(true)
  }, [])

  if (!ready) {
    return (
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', minHeight: '100vh' }}>
        <AstrolabeLoader
          duration={3000}
          onComplete={() => {
            sessionStorage.setItem('splash-seen', '1')
            setReady(true)
          }}
        />
      </div>
    )
  }

  return <>{children}</>
}
```

> Usar `sessionStorage` (não `localStorage`) para mostrar apenas uma vez por sessão, sem bloquear visitas recorrentes.

